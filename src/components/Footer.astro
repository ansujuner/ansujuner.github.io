---
import { siteConfig } from '../site.config';
import { formatYear } from '../lib/posts';
const year = formatYear(new Date());
const years = Number(year) === siteConfig.since ? year : `${siteConfig.since}–${year}`;
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <div class="footer-brand">{siteConfig.title} <span lang="en">/ {siteConfig.titleEn}</span></div>
      <p class="footer-wish">谢谢你路过这里，祝今天也有好心情～</p>
      <p class="footer-copy" lang="en">© {years} · A tiny corner built with Astro.</p>
    </div>
    <nav class="footer-links" aria-label="页脚导航">
      <a href={siteConfig.social.github} target="_blank" rel="noreferrer"><span lang="en">GitHub</span><span class="sr-only">（新窗口打开）</span></a>
      <a href={siteConfig.social.bilibili} target="_blank" rel="noreferrer"><span lang="en">Bilibili</span><span class="sr-only">（新窗口打开）</span></a>
      <a href={`mailto:${siteConfig.social.email}`}><span lang="en">Email</span></a>
      <a href="#top">回到顶部 ↑</a>
    </nav>
  </div>
</footer>
