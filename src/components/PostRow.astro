---
import type { Post } from '../lib/posts';
import { formatShortDate, postHref, readingTime, tagHref } from '../lib/posts';

interface Props { post: Post }
const { post } = Astro.props;
---
<article class="post-row">
  <time datetime={post.data.publishDate.toISOString()}>{formatShortDate(post.data.publishDate)}</time>
  <div>
    <h2><a href={postHref(post)}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <div class="post-row-meta">
      {post.data.tags.map((tag) => <a class="tag" href={tagHref(tag)}>#{tag}</a>)}
    </div>
  </div>
  <span class="read-time">{readingTime(post.body)} 分钟</span>
</article>
