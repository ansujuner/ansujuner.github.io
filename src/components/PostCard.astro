---
import type { Post } from '../lib/posts';
import { formatDate, postHref, readingTime, tagHref } from '../lib/posts';

interface Props {
  post: Post;
  index?: number;
}

const { post, index = 0 } = Astro.props;
---
<article class="post-card">
  <span class="post-card-index">{String(index + 1).padStart(2, '0')}</span>
  <h3><a href={postHref(post)}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <div class="post-card-meta">
    <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
    <span>{readingTime(post.body)} 分钟阅读</span>
    {post.data.tags[0] && <a class="tag" href={tagHref(post.data.tags[0])}>#{post.data.tags[0]}</a>}
  </div>
</article>
