---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面没有找到 / Not Found" description="这个页面不存在，或者已经被移动。" noindex={true}>
  <section class="not-found">
    <div class="container">
      <div class="not-found-code" aria-hidden="true">404</div>
      <h1>这一页不在这里。</h1>
      <p>它可能被移动、删除，或者从来没有存在过。<br /><span lang="en">This page may have moved, disappeared, or never existed.</span></p>
      <div class="hero-actions" style="justify-content:center">
        <a class="button button-primary" href="/">返回首页 / <span lang="en">Home</span></a>
        <a class="button" href="/about/">关于我 / <span lang="en">About</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
