---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="搜索" description="搜索 Ansujuner 博客中的文章。" noindex={true}>
  <header class="page-hero reading-width">
    <span class="eyebrow">Search</span>
    <h1>搜索</h1>
    <p>输入两个或更多字符，搜索标题、摘要与文章正文。所有检索都在你的浏览器中完成。</p>
  </header>
  <section class="reading-width search-wrap" aria-label="站内搜索">
    <div class="search-box">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
      <label class="sr-only" for="site-search">搜索文章</label>
      <input id="site-search" type="search" inputmode="search" autocomplete="off" placeholder="搜索文章…" aria-describedby="search-status" />
    </div>
    <p class="search-status" id="search-status" aria-live="polite">输入关键词开始搜索。</p>
    <ol class="search-results" id="search-results"></ol>
  </section>

  <script is:inline type="module">
    const input = document.querySelector('#site-search');
    const status = document.querySelector('#search-status');
    const list = document.querySelector('#search-results');
    let pagefind;
    let timer;
    let searchSequence = 0;

    const clearResults = () => { if (list) list.replaceChildren(); };
    const renderResult = (data) => {
      const item = document.createElement('li');
      item.className = 'search-result';
      const link = document.createElement('a');
      link.href = data.url;
      link.textContent = data.meta?.title || data.url;
      const excerpt = document.createElement('p');
      excerpt.innerHTML = data.excerpt || data.meta?.description || '';
      item.append(link, excerpt);
      return item;
    };

    const search = async (query) => {
      if (!status || !list) return;
      const sequence = ++searchSequence;
      if (query.trim().length < 2) {
        clearResults();
        status.textContent = '输入至少两个字符。';
        return;
      }
      status.textContent = '正在搜索…';
      try {
        pagefind ||= await import('/pagefind/pagefind.js');
        if (sequence !== searchSequence) return;
        const response = await pagefind.search(query.trim());
        if (sequence !== searchSequence) return;
        const results = await Promise.all(response.results.slice(0, 20).map((result) => result.data()));
        if (sequence !== searchSequence) return;
        clearResults();
        results.forEach((result) => list.append(renderResult(result)));
        status.textContent = results.length ? `找到 ${results.length} 条结果` : '没有找到相关内容。';
      } catch (error) {
        if (sequence !== searchSequence) return;
        clearResults();
        status.textContent = location.hostname === 'localhost'
          ? '搜索索引会在正式构建后可用。'
          : '搜索暂时不可用，请稍后再试。';
      }
    };

    input?.addEventListener('input', (event) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => search(event.target.value), 180);
    });

    const initial = new URLSearchParams(location.search).get('q');
    if (initial && input) {
      input.value = initial;
      search(initial);
    }
  </script>
</BaseLayout>
