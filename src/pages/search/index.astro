---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="搜索 / Search" description="搜索徐丰俊的个人网站。" noindex={true}>
  <header class="page-hero reading-width">
    <span class="eyebrow"><span lang="en">Search</span> · 搜索</span>
    <h1>搜索</h1>
    <p>搜索这个网站中的公开内容。<br /><span lang="en">Search the public content on this site.</span></p>
  </header>
  <section class="reading-width search-wrap" aria-label="站内搜索">
    <div class="search-box">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
      <label class="sr-only" for="site-search">搜索网站 / <span lang="en">Search site</span></label>
      <input id="site-search" type="search" inputmode="search" autocomplete="off" placeholder="输入关键词…" aria-describedby="search-status" />
    </div>
    <p class="search-status" id="search-status" aria-live="polite">输入关键词开始搜索。 <span lang="en">Type to begin.</span></p>
    <ol class="search-results" id="search-results"></ol>
  </section>

  <script is:inline type="module">
    const input = document.querySelector('#site-search');
    const status = document.querySelector('#search-status');
    const list = document.querySelector('#search-results');
    let pagefind;
    let timer;
    let searchSequence = 0;
    const clearResults = () => { if (list) list.replaceChildren(); };
    const setStatus = (zh, en = '') => {
      if (!status) return;
      status.replaceChildren(document.createTextNode(zh));
      if (en) {
        const english = document.createElement('span');
        english.lang = 'en';
        english.textContent = ` ${en}`;
        status.append(english);
      }
    };
    const renderResult = (data) => {
      const item = document.createElement('li'); item.className = 'search-result';
      const link = document.createElement('a'); link.href = data.url; link.textContent = data.meta?.title || data.url;
      const excerpt = document.createElement('p'); excerpt.innerHTML = data.excerpt || data.meta?.description || '';
      item.append(link, excerpt); return item;
    };
    const search = async (query) => {
      if (!status || !list) return;
      const sequence = ++searchSequence;
      if (query.trim().length < 2) { clearResults(); setStatus('输入至少两个字符。', 'Enter at least two characters.'); return; }
      setStatus('正在搜索…', 'Searching…');
      try {
        pagefind ||= await import('/pagefind/pagefind.js');
        if (sequence !== searchSequence) return;
        const response = await pagefind.search(query.trim());
        if (sequence !== searchSequence) return;
        const results = await Promise.all(response.results.slice(0, 20).map((result) => result.data()));
        if (sequence !== searchSequence) return;
        clearResults(); results.forEach((result) => list.append(renderResult(result)));
        if (results.length) setStatus(`找到 ${results.length} 条结果。`, `${results.length} result(s) found.`);
        else setStatus('没有找到相关内容。', 'No results.');
      } catch {
        if (sequence !== searchSequence) return;
        clearResults();
        if (location.hostname === 'localhost') setStatus('搜索索引会在正式构建后可用。', 'Search is available after a production build.');
        else setStatus('搜索暂时不可用，请稍后再试。', 'Search is temporarily unavailable.');
      }
    };
    input?.addEventListener('input', (event) => { window.clearTimeout(timer); timer = window.setTimeout(() => search(event.target.value), 180); });
    const initial = new URLSearchParams(location.search).get('q');
    if (initial && input) { input.value = initial; search(initial); }
  </script>
</BaseLayout>
