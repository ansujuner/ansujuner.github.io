---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectTags, getPublishedPosts, tagHref } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
---
<BaseLayout title="标签" description="按主题浏览 Ansujuner 的文章。">
  <header class="page-hero container">
    <span class="eyebrow">Topics · {String(tags.length).padStart(2, '0')}</span>
    <h1>标签</h1>
    <p>有些主题会反复出现。选择一个关键词，沿着它继续阅读。</p>
  </header>
  <section class="container tag-cloud" aria-label="全部标签">
    {tags.map((tag) => (
      <a class="tag" href={tagHref(tag.name)}>{tag.name}<span class="tag-count">{String(tag.count).padStart(2, '0')}</span></a>
    ))}
  </section>
</BaseLayout>
