---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectTags, getPublishedPosts, tagHref } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
---
<BaseLayout title="标签 / Topics" description="按主题浏览爪印小站的公开文章。" noindex={tags.length === 0}>
  <header class="page-hero container">
    <span class="eyebrow"><span lang="en">Topics</span> · 标签</span>
    <h1>标签</h1>
    <p>文章出现以后，这里会按主题整理。<br /><span lang="en">Topics will appear here when there is something to publish.</span></p>
  </header>
  <section class="container tag-cloud" aria-label="全部标签">
    {tags.length ? tags.map((tag) => (
      <a class="tag" href={tagHref(tag.name)}>{tag.name}<span class="tag-count">{String(tag.count).padStart(2, '0')}</span></a>
    )) : <div class="empty-state compact"><span lang="en">NO TOPICS YET</span><h2>暂时没有标签。</h2></div>}
  </section>
</BaseLayout>
