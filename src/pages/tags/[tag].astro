---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { collectTags, getPublishedPosts } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return collectTags(posts).map(({ name }) => ({
    params: { tag: name },
    props: { tag: name, posts: posts.filter((post) => post.data.tags.includes(name)) },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
---
<BaseLayout title={`标签：${tag}`} description={`所有与“${tag}”相关的文章。`}>
  <header class="page-hero container">
    <span class="eyebrow"><span lang="en">Topic</span> · {String(posts.length).padStart(2, '0')}</span>
    <h1>#{tag}</h1>
    <p>共 {posts.length} 篇文章。<a href="/tags/">返回全部标签</a></p>
  </header>
  <section class="container" aria-label={`${tag}文章列表`}>
    <div class="post-list">
      {posts.map((post) => <PostRow post={post} />)}
    </div>
  </section>
  <div style="height: 6rem"></div>
</BaseLayout>
