---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatShortDate, formatYear, getPublishedPosts, postHref, type Post } from '../lib/posts';

const posts = await getPublishedPosts();
const grouped = new Map<string, Post[]>();
for (const post of posts) {
  const year = formatYear(post.data.publishDate);
  grouped.set(year, [...(grouped.get(year) ?? []), post]);
}
const years = [...grouped.entries()].sort(([a], [b]) => Number(b) - Number(a));
---
<BaseLayout title="归档" description="按年份浏览 Ansujuner 的全部文章。">
  <header class="page-hero container">
    <span class="eyebrow">Archive · {String(posts.length).padStart(2, '0')}</span>
    <h1>归档</h1>
    <p>时间不是分类标准，但它能让一路走来的变化变得清楚。</p>
  </header>
  <section class="container archive" aria-label="文章归档">
    {years.map(([year, yearPosts]) => (
      <div class="archive-year">
        <h2>{year}</h2>
        <ol class="archive-items">
          {yearPosts.map((post) => (
            <li>
              <time datetime={post.data.publishDate.toISOString()}>{formatShortDate(post.data.publishDate).slice(5)}</time>
              <a href={postHref(post)}>{post.data.title}</a>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>
</BaseLayout>
