---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatShortDate, formatYear, getPublishedPosts, postHref, type Post } from '../lib/posts';

const posts = await getPublishedPosts();
const grouped = new Map<string, Post[]>();
for (const post of posts) {
  const year = formatYear(post.data.publishDate);
  grouped.set(year, [...(grouped.get(year) ?? []), post]);
}
const years = [...grouped.entries()].sort(([a], [b]) => Number(b) - Number(a));
---
<BaseLayout title="归档 / Archive" description="按时间浏览徐丰俊的公开文章。" noindex={posts.length === 0}>
  <header class="page-hero container">
    <span class="eyebrow"><span lang="en">Archive</span> · 归档</span>
    <h1>归档</h1>
    <p>未来写下的内容，会在这里留下时间线。<br /><span lang="en">Future writing will form a timeline here.</span></p>
  </header>
  <section class="container archive" aria-label="文章归档">
    {years.length ? years.map(([year, yearPosts]) => (
      <div class="archive-year">
        <h2>{year}</h2>
        <ol class="archive-items">
          {yearPosts.map((post) => (
            <li><time datetime={post.data.publishDate.toISOString()}>{formatShortDate(post.data.publishDate).slice(5)}</time><a href={postHref(post)}>{post.data.title}</a></li>
          ))}
        </ol>
      </div>
    )) : <div class="empty-state compact"><span lang="en">NO ARCHIVE YET</span><h2>时间线还没有开始。</h2></div>}
  </section>
</BaseLayout>
