---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.author,
  alternateName: siteConfig.romanizedName,
  url: siteConfig.url,
  email: `mailto:${siteConfig.social.email}`,
  homeLocation: { '@type': 'Place', name: siteConfig.profile.locationEn },
  description: siteConfig.description,
  sameAs: [siteConfig.social.github, siteConfig.social.bilibili],
};
---
<BaseLayout jsonLd={jsonLd}>
  <div data-pagefind-body>
    <section class="profile-hero">
      <div class="container profile-hero-grid">
        <div class="profile-hero-copy">
          <span class="eyebrow" lang="en">Student · Hangzhou · Open Source</span>
          <div class="profile-name-wrap">
            <h1 data-pagefind-meta="title">{siteConfig.title}</h1>
            <p class="profile-name-en" lang="en">{siteConfig.romanizedName} · Pinyin</p>
          </div>
          <div class="profile-motto">
            <p>{siteConfig.tagline}</p>
            <span lang="en">{siteConfig.taglineEn}</span>
          </div>
          <div class="profile-lead">
            <p>你好呀，我是徐丰俊。我在杭州上学，喜欢天马星空的项目，也是一名坚定的开源主义者。这里是一份轻松的自我介绍。</p>
            <p lang="en">Hi, I’m Xu Fengjun, a student in Hangzhou. I enjoy imaginative projects and am a committed believer in open source. This is a short introduction to me.</p>
          </div>
          <div class="hero-actions">
            <a class="button button-primary" href="#about">来认识一下 <span aria-hidden="true">↓</span></a>
            <a class="button" href="#contact">打个招呼 / <span lang="en">Say hello</span></a>
          </div>
        </div>

        <aside class="hero-note profile-card" aria-label="个人名片">
          <div class="hero-note-top" lang="en"><span>XU / FENGJUN</span><span>HANGZHOU</span></div>
          <div class="monogram monogram-han" aria-hidden="true">{siteConfig.profile.initial}</div>
          <div class="hero-note-bottom">
            <p>{siteConfig.profile.role}<br /><span lang="en">{siteConfig.profile.roleEn}</span></p>
            <span class="profile-location">{siteConfig.profile.location}<small lang="en">{siteConfig.profile.locationEn}</small></span>
          </div>
        </aside>
      </div>
    </section>

    <section class="identity-section" aria-label="个人信息">
      <div class="container identity-grid">
        <div class="identity-item"><span lang="en">STATUS</span><strong>{siteConfig.profile.role}</strong><small lang="en">{siteConfig.profile.roleEn}</small></div>
        <div class="identity-item"><span lang="en">BASE</span><strong>{siteConfig.profile.location}</strong><small lang="en">{siteConfig.profile.locationEn}</small></div>
        <div class="identity-item"><span lang="en">INTEREST</span><strong>天马星空</strong><small lang="en">Imaginative projects</small></div>
        <div class="identity-item"><span lang="en">BELIEF</span><strong>开源主义</strong><small lang="en">Open source</small></div>
      </div>
    </section>

    <section class="section profile-about" id="about">
      <div class="container profile-section-grid">
        <div class="profile-section-title">
          <span class="eyebrow" lang="en">About me · 01</span>
          <h2>来认识一下<br />我吧。</h2>
          <p lang="en">A short introduction.</p>
        </div>
        <div class="bilingual-copy">
          <div class="language-block">
            <span class="language-label">中文 / ZH</span>
            <p>我是徐丰俊，一名在杭州的在校学生。我喜欢天马星空的项目，也是一名坚定的开源主义者。这个网站放着我的简单介绍和公开联系方式。</p>
          </div>
          <div class="language-block" lang="en">
            <span class="language-label">ENGLISH / EN</span>
            <p>I’m Xu Fengjun (pinyin), a student based in Hangzhou. I enjoy imaginative projects and am a committed believer in open source. This site contains a short introduction and my public contact details.</p>
          </div>
          <a class="text-link" href="/about/">继续了解我 / <span lang="en">More about me</span> <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="values-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow" lang="en">What matters · 02</span>
            <h2 id="values-title">我喜欢的事。</h2>
          </div>
          <p class="section-sidecopy" lang="en">Three facts about me.</p>
        </div>
        <div class="value-grid">
          <article class="value-card">
            <span>01</span><h3>天马星空</h3><p>我喜欢富有想象力的项目。</p>
            <hr /><h4 lang="en">Imagination</h4><p lang="en">I enjoy imaginative projects.</p>
          </article>
          <article class="value-card">
            <span>02</span><h3>开源主义</h3><p>开源很棒，我会坚定地站在这边。</p>
            <hr /><h4 lang="en">Open source</h4><p lang="en">Open source is wonderful, and I firmly stand behind it.</p>
          </article>
          <article class="value-card">
            <span>03</span><h3>在校学习</h3><p>我目前是一名在校学生。</p>
            <hr /><h4 lang="en">Student</h4><p lang="en">I am currently a student.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container now-panel profile-now">
        <span class="now-dot" aria-hidden="true"></span>
        <div>
          <span class="language-label"><span lang="en">NOW</span> / 现在</span>
          <h2>{siteConfig.now}</h2>
          <p lang="en">{siteConfig.nowEn}</p>
        </div>
        <span class="now-place">杭州<small lang="en">Hangzhou</small></span>
      </div>
    </section>

    <section class="section contact-section" id="contact">
      <div class="container contact-panel">
        <div>
          <span class="eyebrow" lang="en">Say hello · 03</span>
          <h2>要来打个招呼吗？</h2>
          <p>目前我不求职，也不接单。不过想说声你好时，可以通过下面的公开渠道找到我，喵。</p>
          <p lang="en">I’m not currently looking for work or taking commissions. You can still say hello through the public channels below.</p>
        </div>
        <div class="contact-links">
          <a class="contact-link contact-link-primary" href={`mailto:${siteConfig.social.email}`}>
            <span lang="en">EMAIL</span><strong>{siteConfig.social.email}</strong><i aria-hidden="true">↗</i>
          </a>
          <a class="contact-link" href={siteConfig.social.github} target="_blank" rel="noreferrer">
            <span lang="en">GITHUB</span><strong>@ansujuner</strong><i aria-hidden="true">↗</i><span class="sr-only">（新窗口打开）</span>
          </a>
          <a class="contact-link" href={siteConfig.social.bilibili} target="_blank" rel="noreferrer">
            <span lang="en">BILIBILI</span><strong>{siteConfig.social.bilibiliName}</strong><i aria-hidden="true">↗</i><span class="sr-only">（新窗口打开）</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
