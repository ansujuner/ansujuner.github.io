---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { siteConfig } from '../site.config';
import { collectTags, getPublishedPosts, tagHref } from '../lib/posts';

const posts = await getPublishedPosts();
const featured = posts.filter((post) => post.data.featured).slice(0, 3);
const tags = collectTags(posts).slice(0, 5);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: siteConfig.title,
      url: siteConfig.url,
      description: siteConfig.description,
      inLanguage: siteConfig.locale,
    },
    {
      '@type': 'Person',
      name: siteConfig.author,
      url: siteConfig.url,
      sameAs: [siteConfig.social.github],
    },
  ],
};
---
<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Personal notes · Since {siteConfig.since}</span>
        <h1>在代码与日常之间，认真写下一些东西。</h1>
        <p class="hero-copy">{siteConfig.description} 不追赶每一个热点，只保存值得反复阅读的内容。</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/posts/">
            开始阅读
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="button" href="/about/">关于这个博客</a>
        </div>
      </div>
      <aside class="hero-note" aria-label="博客名片">
        <div class="hero-note-top"><span>ANSUJUNER / NOTES</span><span>01</span></div>
        <div class="monogram" aria-hidden="true">A</div>
        <div class="hero-note-bottom">
          <p>{siteConfig.tagline}<br />保持好奇，持续记录。</p>
          <span class="hero-note-number">{String(posts.length).padStart(2, '0')}</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Selected writing</span>
          <h2>精选文章</h2>
        </div>
        <a class="text-link" href="/posts/">查看全部 <span aria-hidden="true">→</span></a>
      </div>
      <div class="post-grid">
        {featured.map((post, index) => <PostCard post={post} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container topic-panel">
      <div class="topic-intro">
        <span class="eyebrow">Topics</span>
        <h2>好奇心没有固定边界。</h2>
        <p>从具体的技术问题，到产品细节与生活观察。标签只是入口，思考可以自由穿行。</p>
      </div>
      <div class="topic-list">
        {tags.map((tag) => (
          <a class="topic-row" href={tagHref(tag.name)}>
            <strong>{tag.name}</strong>
            <span>{String(tag.count).padStart(2, '0')} NOTES ↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container now-panel">
      <span class="now-dot" aria-hidden="true"></span>
      <div>
        <h2>最近在做</h2>
        <p>{siteConfig.now}</p>
      </div>
      <a class="button" href="/rss.xml">通过 RSS 订阅</a>
    </div>
  </section>
</BaseLayout>
