---
import BaseLayout from './BaseLayout.astro';
import { siteConfig } from '../site.config';
import type { Post } from '../lib/posts';
import { formatDate, postHref, readingTime, tagHref } from '../lib/posts';
import { render } from 'astro:content';

interface Props {
  post: Post;
  previous?: Post;
  next?: Post;
}

const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
const canonicalPath = postHref(post);
const canonical = new URL(canonicalPath, siteConfig.url).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  inLanguage: siteConfig.locale,
  mainEntityOfPage: canonical,
  author: { '@type': 'Person', name: siteConfig.author, url: siteConfig.url },
  publisher: { '@type': 'Person', name: siteConfig.author },
  keywords: post.data.tags.join(', '),
};
---
<BaseLayout title={post.data.title} description={post.data.description} type="article" canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.publishDate.toISOString()} />
    <meta property="article:modified_time" content={(post.data.updatedDate ?? post.data.publishDate).toISOString()} />
    <meta property="article:author" content={new URL('/about/', siteConfig.url).toString()} />
    {post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </Fragment>
  <article>
    <header class="article-header">
      <div class="container">
        <span class="eyebrow"><span lang="en">Writing</span> · {post.data.tags[0]}</span>
        <h1 data-pagefind-meta="title">{post.data.title}</h1>
        <p class="article-dek" data-pagefind-meta="description">{post.data.description}</p>
        <div class="article-meta">
          <time datetime={post.data.publishDate.toISOString()}>发布于 {formatDate(post.data.publishDate)}</time>
          {post.data.updatedDate && <time datetime={post.data.updatedDate.toISOString()}>更新于 {formatDate(post.data.updatedDate)}</time>}
          <span>{readingTime(post.body)} 分钟阅读</span>
        </div>
        <div class="article-tags" data-pagefind-meta="tags">
          {post.data.tags.map((tag) => <a class="tag" href={tagHref(tag)}>#{tag}</a>)}
        </div>
      </div>
      <div class="article-rule"></div>
    </header>

    <div class="article-layout">
      <div class="article-content" data-pagefind-body>
        <Content />
      </div>
      {headings.length > 0 && (
        <aside class="toc" aria-label="文章目录">
          <h2>本文目录</h2>
          <ol>
            {headings.filter((heading) => heading.depth <= 3).map((heading) => (
              <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </aside>
      )}
    </div>
  </article>

  <footer class="article-footer reading-width">
    <div class="share-row">
      <p>如果这篇文章对你有帮助，可以分享给更多人。</p>
      <div class="share-actions">
        <button class="share-button" type="button" data-copy-link>复制链接</button>
        <a class="share-button" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(canonical)}`} target="_blank" rel="noreferrer">分享<span class="sr-only">（新窗口打开）</span></a>
      </div>
    </div>
    {(previous || next) && (
      <nav class="post-nav" aria-label="相邻文章">
        {previous ? <a href={postHref(previous)}><span>上一篇</span><strong>{previous.data.title}</strong></a> : <span></span>}
        {next && <a href={postHref(next)}><span>下一篇</span><strong>{next.data.title}</strong></a>}
      </nav>
    )}
  </footer>

  <script>
    document.querySelectorAll<HTMLElement>('.article-content pre').forEach((pre) => {
      if (pre.querySelector('.copy-code')) return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code';
      button.textContent = '复制';
      button.setAttribute('aria-label', '复制代码');
      button.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent ?? '';
        await navigator.clipboard.writeText(code);
        button.textContent = '已复制';
        setTimeout(() => (button.textContent = '复制'), 1600);
      });
      pre.appendChild(button);
    });
    document.querySelector<HTMLButtonElement>('[data-copy-link]')?.addEventListener('click', async (event) => {
      await navigator.clipboard.writeText(location.href);
      const button = event.currentTarget as HTMLButtonElement;
      button.textContent = '已复制';
      setTimeout(() => (button.textContent = '复制链接'), 1600);
    });
  </script>
</BaseLayout>
