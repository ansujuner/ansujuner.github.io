3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"把日子过慢一点 | 留白"}],["$","meta","1",{"name":"description","content":"散步不一定要有目的地，周末也不必被安排填满。偶尔把时间还给自己，才发现，平常的日子里也藏着许多微小的好。"}],["$","link","2",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["posts","a-slower-day"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"posts","fallback":["$","main",null,{"id":"main","className":"article-shell missing-page","children":[["$","p",null,{"className":"eyebrow","children":"404 · 一页留白"}],["$","h1",null,{"children":"这页文字，还没有写下。"}],["$","p",null,{"children":"文章可能已被移动，回到首页继续看看吧。"}],["$","a",null,{"href":"/","className":"read-link","children":["返回首页 ",["$","span",null,{"children":"↗"}]]}]]}],"children":["$","$La",null,{"resetKey":"[\"posts\",\"slug|a-slower-day|d\"]","fallback":["$","main",null,{"id":"main","className":"article-shell missing-page","children":[["$","p",null,{"className":"eyebrow","children":"404 · 一页留白"}],["$","h1",null,{"children":"这页文字，还没有写下。"}],["$","p",null,{"children":"文章可能已被移动，回到首页继续看看吧。"}],["$","a",null,{"href":"/","className":"read-link","children":["返回首页 ",["$","span",null,{"children":"↗"}]]}]]}],"children":["$","$Lb",null,{"children":["$","$Lc",null,{"children":[["$","$L8",null,{"providerId":"page:/posts/a-slower-day","segmentMap":{"children":["__PAGE__"]},"children":["$","$L9",null,{"id":"page:/posts/a-slower-day"}]}],null]}]}]}]}]}]}]}]}],null,null]
