1:["$","main",null,{"id":"main","className":"article-shell about-page","children":[["$","a",null,{"href":"/","className":"back-link","children":"← 回到首页"}],["$","p",null,{"className":"eyebrow","children":"BEHIND THE WORDS"}],["$","h1",null,{"children":["你好，",["$","br",null,{}],"欢迎来到「留白」。"]}],["$","div",null,{"className":"prose","children":[["$","p",null,{"className":"about-lead","children":["一个普通的生活观察者，",["$","br",null,{}],"用文字，留住一些容易被忘记的片刻。"]}],["$","p",null,{"children":"喜欢慢慢走路，读没读完的书，也喜欢没有安排的下午。关心宏大的世界，但更愿意从一杯热茶、一段对话、一条走过很多次的街道开始写。"}],["$","h2",null,{"children":"为什么叫留白"}],["$","p",null,{"children":"生活里已经有很多声音了，所以想在这里留一个安静的角落。不急着下结论，不追赶热点。想到什么就写一点，让散落的念头有个可以回来的地方。"}],["$","h2",null,{"children":"这里会写些什么"}],["$","p",null,{"children":"生活随笔，记下平常日子里的小事；阅读札记，留住书页之间的回声；还有一些尚未成熟的思考，它们不一定给出答案，但足够真实。"}],["$","blockquote",null,{"children":"把注意力放回生活，把生活慢慢写下来。"}],["$","p",null,{"children":"谢谢你在这里停留。希望某一段文字，会让你想起自己的一个片刻。"}]]}],["$","div",null,{"className":"about-sign","children":["留白",["$","span",null,{"children":"生活与思考 · SINCE 2026"}]]}],["$","aside",null,{"className":"sample-notice","children":"此处为示例作者介绍，姓名、经历和文章均可替换为你自己的内容。"}],["$","a",null,{"className":"read-link","href":"/#writing","children":["去读一篇文章 ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]
